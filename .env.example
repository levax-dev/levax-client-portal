# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by admin actions (inviting users, etc). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL, used to build absolute links in emails and auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email — resend.com)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Levax Client Portal <notifications@yourdomain.com>"

# Business timezone — decides when "today" rolls over on the schedule, dashboard
# and work log. Vercel runs in UTC, which would flip the date mid-morning for a
# team in Asia, so set this to where the team actually works.
# Any IANA name, e.g. Asia/Kolkata, Europe/London, America/New_York.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
